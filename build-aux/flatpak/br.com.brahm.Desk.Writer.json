            "build-commands": [
                "cargo build --release --locked --package desk-writer",
                "install -Dm755 $CARGO_TARGET_DIR/release/desk-writer -t /app/bin",
                "install -Dm644 data/br.com.brahm.Desk.Writer.desktop -t /app/share/applications",
                "install -Dm644 data/br.com.brahm.Desk.Writer.metainfo.xml -t /app/share/metainfo",
