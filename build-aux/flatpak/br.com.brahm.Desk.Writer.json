{
    "id": "br.com.brahm.Desk.Writer",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command": "desk-writer",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "build-args": [
            "--share=network"
        ],
        "env": {
            "CARGO_HOME": "/run/build/desk/cargo",
            "CARGO_TARGET_DIR": "/run/build/desk/target"
        }
    },
    "cleanup": [
        "/share/doc"
    ],
    "modules": [
        {
            "name": "substitute-fonts",
            "buildsystem": "simple",
            "build-commands": [
                "for deb in *.deb; do bsdtar -xOf \"$deb\" 'data.tar.*' | bsdtar -xf -; done",
                "install -Dm644 -t /app/share/fonts/liberation usr/share/fonts/truetype/liberation/*.ttf",
                "install -Dm644 -t /app/share/fonts/crosextra usr/share/fonts/truetype/crosextra/*.ttf",
                "install -Dm644 -t /app/share/fonts/tex-gyre usr/share/texmf/fonts/opentype/public/tex-gyre/*.otf",
                "install -Dm644 -t /app/share/fonts/urw-base35 usr/share/fonts/opentype/urw-base35/*.otf",
                "install -Dm644 -t /app/share/fonts/dejavu usr/share/fonts/truetype/dejavu/*.ttf",
                "for doc in usr/share/doc/*/copyright; do install -Dm644 \"$doc\" /app/share/licenses/br.com.brahm.Desk.Writer/$(basename $(dirname \"$doc\")); done"
            ],
            "sources": [
                {
                    "type": "file",
                    "url": "https://archive.ubuntu.com/ubuntu/pool/main/f/fonts-liberation/fonts-liberation_2.1.5-3_all.deb",
                    "sha256": "065c2ab1abc9108b17d401016dc594b79750904390f095845c93bb06e1153acc"
                },
                {
                    "type": "file",
                    "url": "https://archive.ubuntu.com/ubuntu/pool/universe/f/fonts-crosextra-carlito/fonts-crosextra-carlito_20230309-2_all.deb",
                    "sha256": "c238087a909a4f1d1c5c1a5e1ed42ab9cb522f09ea2715e8deab6ee2751b9a01"
                },
                {
                    "type": "file",
                    "url": "https://archive.ubuntu.com/ubuntu/pool/universe/f/fonts-crosextra-caladea/fonts-crosextra-caladea_20200211-2_all.deb",
                    "sha256": "1a85651d71331a0e07dafa5d54e9aa54b445c29ae0dacb8c7cd224b1b7baaf82"
                },
                {
                    "type": "file",
                    "url": "https://archive.ubuntu.com/ubuntu/pool/universe/t/tex-gyre/fonts-texgyre_20180621-6_all.deb",
                    "sha256": "dc743718ece939f4a868e15012e383aa9bf6501ed6857c895835911053ef250a"
                },
                {
                    "type": "file",
                    "url": "https://archive.ubuntu.com/ubuntu/pool/main/f/fonts-urw-base35/fonts-urw-base35_20200910-8_all.deb",
                    "sha256": "46e75490faa7fd6fddbc8df234d14e0f7b60ea5e98563227a24d6bf5e5008647"
                },
                {
                    "type": "file",
                    "url": "https://archive.ubuntu.com/ubuntu/pool/main/f/fonts-dejavu/fonts-dejavu-core_2.37-8_all.deb",
                    "sha256": "40049660c194f3b8a2541fc7369efebb10e9f94bdac836a2f38fafedd10fa73a"
                },
                {
                    "type": "file",
                    "url": "https://archive.ubuntu.com/ubuntu/pool/main/f/fonts-dejavu/fonts-dejavu-mono_2.37-8_all.deb",
                    "sha256": "8a599d6553307db7ecb795d2f0e5a301e03234afc75c7358b0ba43466454c89a"
                }
            ]
        },
        {
            "name": "gelasio",
            "buildsystem": "simple",
            "build-commands": [
                "install -Dm644 -t /app/share/fonts/gelasio Gelasio-*.ttf",
                "install -Dm644 OFL.txt /app/share/licenses/br.com.brahm.Desk.Writer/fonts-gelasio"
            ],
            "sources": [
                {
                    "type": "file",
                    "url": "https://raw.githubusercontent.com/SorkinType/Gelasio/9228e69b160d79f33950e026293f6e13ba9780d0/fonts/ttf/Gelasio-Regular.ttf",
                    "sha256": "48c797fbe0e07c48a18cb962e7bdfa23f19618327dddf54093265328dc9eb39d"
                },
                {
                    "type": "file",
                    "url": "https://raw.githubusercontent.com/SorkinType/Gelasio/9228e69b160d79f33950e026293f6e13ba9780d0/fonts/ttf/Gelasio-Italic.ttf",
                    "sha256": "1d8bda4ff258bb8251eae4f7d7500c8d97d084136192bb264bc2305168765d1b"
                },
                {
                    "type": "file",
                    "url": "https://raw.githubusercontent.com/SorkinType/Gelasio/9228e69b160d79f33950e026293f6e13ba9780d0/fonts/ttf/Gelasio-Bold.ttf",
                    "sha256": "e0ef3addf1acf35f5c6aef2be00d0a2c01363bf70a5950e16650976051a0c462"
                },
                {
                    "type": "file",
                    "url": "https://raw.githubusercontent.com/SorkinType/Gelasio/9228e69b160d79f33950e026293f6e13ba9780d0/fonts/ttf/Gelasio-BoldItalic.ttf",
                    "sha256": "aa87e21b46aef3dcb50a68dc6e1946f0c0a9819d067e4be6a98a6daa8f5b3c16"
                },
                {
                    "type": "file",
                    "url": "https://raw.githubusercontent.com/SorkinType/Gelasio/9228e69b160d79f33950e026293f6e13ba9780d0/OFL.txt",
                    "sha256": "b393cb01867c919b44381512120dc3e4c954c7b47e2035c405f3a324799a4d29"
                }
            ]
        },
        {
            "name": "dictionaries",
            "buildsystem": "simple",
            "build-commands": [
                "for deb in *.deb; do bsdtar -xOf \"$deb\" 'data.tar.*' | bsdtar -xf -; done",
                "install -Dm644 -t /app/share/hunspell usr/share/hunspell/*.aff usr/share/hunspell/*.dic",
                "mkdir -p /app/share/hyphen",
                "cp -P usr/share/hyphen/*.dic /app/share/hyphen/",
                "for doc in usr/share/doc/*/copyright; do install -Dm644 \"$doc\" /app/share/licenses/br.com.brahm.Desk.Writer/$(basename $(dirname \"$doc\")); done"
            ],
            "sources": [
                {
                    "type": "file",
                    "url": "https://archive.ubuntu.com/ubuntu/pool/main/s/scowl/hunspell-en-us_2020.12.07-2_all.deb",
                    "sha256": "d231c94b54792215038a4f719c562deafe8efe0a7710c0c7218974cab513330c"
                },
                {
                    "type": "file",
                    "url": "https://archive.ubuntu.com/ubuntu/pool/main/libr/libreoffice-dictionaries/hunspell-en-gb_24.2.1-1_all.deb",
                    "sha256": "b616d49d392b23a13df4f98b8e387b1ca71410c510acee55f81ab541cde026df"
                },
                {
                    "type": "file",
                    "url": "https://archive.ubuntu.com/ubuntu/pool/main/libr/libreoffice-dictionaries/hunspell-pt-br_24.2.1-1_all.deb",
                    "sha256": "69a66b415faa240c5ec64a151562800b6e820a3c2e50dafb391246f98af36485"
                },
                {
                    "type": "file",
                    "url": "https://archive.ubuntu.com/ubuntu/pool/main/h/hyphen/hyphen-en-us_2.8.8-7build3_all.deb",
                    "sha256": "15f9abe20c1a3d67b4102a47a3872ff4308275c4cb70b2ea00e98a884691e699"
                },
                {
                    "type": "file",
                    "url": "https://archive.ubuntu.com/ubuntu/pool/main/libr/libreoffice-dictionaries/hyphen-pt-br_24.2.1-1_all.deb",
                    "sha256": "8dd169aa223bc789b733f06c1b5ced358de57b02ceffd0e2acbb49a2c876e218"
                }
            ]
        },
        {
            "name": "desk",
            "buildsystem": "simple",
            "build-commands": [
                "cargo build --release --locked --package desk-writer",
                "install -Dm755 $CARGO_TARGET_DIR/release/desk-writer -t /app/bin",
                "install -Dm644 data/br.com.brahm.Desk.Writer.desktop -t /app/share/applications",
                "install -Dm644 data/br.com.brahm.Desk.Writer.metainfo.xml -t /app/share/metainfo",
                "install -Dm644 data/icons/hicolor/scalable/apps/br.com.brahm.Desk.Writer.svg -t /app/share/icons/hicolor/scalable/apps",
                "install -Dm644 data/icons/hicolor/symbolic/apps/br.com.brahm.Desk.Writer-symbolic.svg -t /app/share/icons/hicolor/symbolic/apps"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": "../..",
                    "skip": [
                        "target",
                        "fuzz",
                        "corpus",
                        "site",
                        "experiments"
                    ]
                }
            ]
        }
    ]
}
