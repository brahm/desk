# A box of side 2 around the origin, made by make_obj.py.
mtllib box materials.mtl
o Box
v -1 -1 -1
v 1 -1 -1
v 1 1 -1
v -1 1 -1
v -1 -1 1
v 1 -1 1
v 1 1 1
v -1 1 1
vt 0 0
vt 1 0
vt 1 1
vt 0 1
vn 0 0 1
vn 0 0 -1
vn 1 0 0
vn -1 0 0
vn 0 1 0
vn 0 -1 0
g sides
usemtl Red
f 2//3 3//3 7//3 6//3
f 1//4 5//4 8//4 4//4
f 1//6 2//6 6//6 5//6
f 1//2 4//2 3//2 2//2
usemtl Wood
# The top, by numbers back from the last.
f -1/-1/-2 -2/-2/-2 3/2/5 \
  4/1/5
usemtl Glass
f 5/1/1 6/2/1 7/3/1 8/4/1
