";ENCODING=QUOTED-PRINTABLE"
";CHARSET=UTF-8"
"=C3=A9"
"\x5cn"
"\x5c;"
"\x0d\x0a"
"\""
","
";"
"\x09"
"<office:spreadsheet>"
